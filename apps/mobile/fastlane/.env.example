# Copy to fastlane/.env (gitignored) and fill in real values.
#   cp fastlane/.env.example fastlane/.env

# --- iOS ---
APPLE_TEAM_ID=
APPLE_ID=
ITC_TEAM_ID=

MATCH_GIT_URL=git@github.com:YOUR_ORG/fitcupons-ios-signing.git
MATCH_PASSWORD=

APP_STORE_CONNECT_KEY_ID=
APP_STORE_CONNECT_ISSUER_ID=
APP_STORE_CONNECT_KEY_PATH=secrets/AuthKey_XXXXXXXX.p8

# IOS_SCHEME=fitcupons
# IOS_DEVICE_UDID=

# --- Android ---
ANDROID_KEYSTORE_PATH=secrets/fitcupons-release.keystore
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=

EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
GOOGLE_PLAY_JSON_KEY_PATH=secrets/google-play.json

# Optional overrides. Unset = max(app.json, store max + 1)
# IOS_BUILD_NUMBER=2
# ANDROID_VERSION_CODE=3

# FASTLANE_PREBUILD_CLEAN=1
