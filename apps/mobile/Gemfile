source "https://rubygems.org"

ruby ">= 3.2.0"

gem "fastlane"
# Locked with Fastlane so `bundle exec` can run `pod install` (Expo must not
# install CocoaPods into a different Ruby). Same version on every machine/CI.
gem "cocoapods", "~> 1.16"
gem "dotenv"

plugins_path = File.join(File.dirname(__FILE__), "fastlane", "Pluginfile")
eval_gemfile(plugins_path) if File.exist?(plugins_path)
