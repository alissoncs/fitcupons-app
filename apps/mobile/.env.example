# Copy to .env (gitignored). Restart Expo after changing EXPO_PUBLIC_* (`expo start -c`).
# Full map: ../../docs/ENV.md

# iOS simulator: localhost. Android emulator: http://10.0.2.2:3000. Physical device: http://<LAN-IP>:3000
EXPO_PUBLIC_API_URL=http://localhost:3000

# auto = probe GET /health (default)
# true | mock = always use in-app mocks
# false | live = always call the API
EXPO_PUBLIC_USE_MOCK=auto

# Google Sign-In — same three client IDs as the API GOOGLE_CLIENT_ID_* vars
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
