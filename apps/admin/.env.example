# Server-side only. Do not prefix with NEXT_PUBLIC_ — the admin JWT stays in an httpOnly cookie.
# Docs: ../../docs/ENV.md

API_URL=http://localhost:3000

# auto = probe GET /health (default)
# true | mock = always use local mocks
# false | live = always call the API (visible failure if it is down)
ADMIN_USE_MOCK=auto

# Must match API ADMIN_JWT_EXPIRES_IN (2h)
ADMIN_COOKIE_MAX_AGE_SECONDS=7200
